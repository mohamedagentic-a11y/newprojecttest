# Backend Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# .env and .env.* (except .env.example) are listed in .gitignore.

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/skywings_db

# ─── JWT Secrets ─────────────────────────────────────────────────────────────
# Secret key for signing access tokens (JWT, short-lived 30m)
# Use a long, random, cryptographically secure string (minimum 64 characters)
JWT_SECRET=replace_with_a_long_random_access_token_secret_minimum_64_chars

# Secret key for signing refresh tokens (HttpOnly cookie, 7d TTL)
# Must differ from JWT_SECRET; use another long random string
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_token_secret_minimum_64_chars

# ─── Server ──────────────────────────────────────────────────────────────────
# Port the Express server listens on
PORT=3001

# Node environment: development | test | production
NODE_ENV=development

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
# Example for multiple origins: http://localhost:3000,https://app.skywings.aero
CORS_ORIGIN=http://localhost:3000

# ─── GDS (Global Distribution System) Adapter ───────────────────────────────
# Base URL of the GDS API used for real-time flight/fare inventory queries
GDS_API_URL=https://gds.example.com/api/v1

# API key for authenticating requests to the GDS
GDS_API_KEY=replace_with_your_gds_api_key

# ─── Loyalty Program API ─────────────────────────────────────────────────────
# Base URL of the Loyalty miles/redemption service
LOYALTY_API_URL=https://loyalty.example.com/api/v1

# API key for authenticating requests to the Loyalty service
LOYALTY_API_KEY=replace_with_your_loyalty_api_key