# Environment variables for the backend service.
# Copy this file to .env (which is git-ignored) and fill in real values.
# Never commit .env or any file containing real secrets.

# PostgreSQL connection string
# Example: postgres://user:password@host:5432/dbname
DATABASE_URL=postgres://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_HOST:5432/CHANGE_ME_DBNAME

# Secret used to sign JWT access tokens (30-minute lifetime)
# Generate with: node -e "require('crypto').randomBytes(64).toString('hex').then ? '' : console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_JWT_SECRET

# Secret used to sign JWT refresh tokens (7-day lifetime, stored as HttpOnly cookie)
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_SECRET

# Port the Express server listens on
PORT=3001

# Global Distribution System (GDS) API credentials
GDS_API_KEY=CHANGE_ME_GDS_API_KEY
GDS_API_URL=https://CHANGE_ME_GDS_PROVIDER/api

# Payment gateway integration
PAYMENT_GATEWAY_URL=https://CHANGE_ME_PAYMENT_GATEWAY/api
PAYMENT_GATEWAY_KEY=CHANGE_ME_PAYMENT_GATEWAY_KEY

# Comma-separated list of allowed CORS origins (no trailing slashes)
# Example: http://localhost:3000,https://app.example.com
CORS_ORIGIN=http://localhost:3000